# BAZA Import — статика на Apache (reg.ru). Хеши инлайн-скриптов в CSP подставляет scripts/prerender.mjs.

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Редирект на HTTPS здесь не делаем: на reg.ru HTTPS снимает фронтовый nginx, и правило по %{HTTPS}
  # может зациклиться. Включается в панели хостинга: «SSL-сертификат → Перенаправление на HTTPS».

  # Один хост: www → без www (Метрика и поиск видят один сайт)
  RewriteCond %{HTTP_HOST} ^www\.bazaimporta\.ru$ [NC]
  RewriteRule ^(.*)$ https://bazaimporta.ru/$1 [R=301,L]

  # Старые адреса без завершающего слеша → страница трека
  RewriteRule ^(s-nulya|est-opyt|dlya-sebya|thank-you)$ /$1/ [R=301,L]

  # Трек «Профи» переименован в «Есть опыт»: старый адрес → новый
  RewriteRule ^profi/?$ /est-opyt/ [R=301,L]

  # Закрыть служебное: скрытые файлы (.git, .env, .htaccess …), исходники и бэкапы
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(map|md|log|sql|bak|zip|tar|gz|sh|env|ini|lock|json)$ - [F,L,NC]
  RewriteRule ^(src|scripts|node_modules|backend|tgbot|audit|docs|brand)(/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  # Встраивание во фрейм запрещено всем, кроме самой Метрики (карта кликов и Вебвизор показывают сайт во фрейме).
  # Поэтому вместо X-Frame-Options: DENY — frame-ancestors в CSP.
  Header always unset X-Frame-Options
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Метрика и Вебвизор — по yandex.ru/support/metrica/ru/code/install-counter-csp: tag.js и сеть — все домены mc.yandex.* и mc.webvisor.*
  # (счётчик синхронизирует куки между ними), yastatic.net; Вебвизору нужны blob:-фреймы и воркеры.
  # frame-ancestors — список интерфейсов Метрики из той же статьи: в них карта кликов и Вебвизор показывают сайт во фрейме.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-vyyoz7oKq/TDmq1Px+rzeNL4w2Zct66jMagWCzuj4GE=' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org; font-src 'self'; connect-src 'self' https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org wss://mc.yandex.ru wss://mc.yandex.az wss://mc.yandex.by wss://mc.yandex.co.il wss://mc.yandex.com wss://mc.yandex.com.am wss://mc.yandex.com.ge wss://mc.yandex.com.tr wss://mc.yandex.ee wss://mc.yandex.fr wss://mc.yandex.kg wss://mc.yandex.kz wss://mc.yandex.lt wss://mc.yandex.lv wss://mc.yandex.md wss://mc.yandex.tj wss://mc.yandex.tm wss://mc.yandex.uz wss://mc.webvisor.com wss://mc.webvisor.org; frame-src blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org; child-src blob: https://mc.yandex.ru https://mc.yandex.az https://mc.yandex.by https://mc.yandex.co.il https://mc.yandex.com https://mc.yandex.com.am https://mc.yandex.com.ge https://mc.yandex.com.tr https://mc.yandex.ee https://mc.yandex.fr https://mc.yandex.kg https://mc.yandex.kz https://mc.yandex.lt https://mc.yandex.lv https://mc.yandex.md https://mc.yandex.tj https://mc.yandex.tm https://mc.yandex.uz https://mc.webvisor.com https://mc.webvisor.org; worker-src 'self' blob:; media-src 'self'; frame-ancestors 'self' https://metrika.yandex.ru https://analytics.yandex.by https://analytics.yandex.com https://analytics.yandex.com.tr https://analytics.yandex.kz https://analytics.yandex.ru https://metr.yandex.by https://metr.yandex.com https://metr.yandex.com.tr https://metr.yandex.kz https://metr.yandex.ru https://metrica.ya.ru https://metrica.yandex https://metrica.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex.kz https://metrica.yandex.ru https://metrika.ya.ru https://metrika.yandex https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex.kz https://metrika.yandex.uz; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By

  # Файлы с хешем в имени — навсегда; HTML — всегда свежий
  <FilesMatch "\.(js|css|woff2?|webp|avif|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(metrika\.js|favicon\.svg|og\.jpg|apple-touch-icon\.png)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

