# Кабинет заявок: только index.php, закрыт от поисковиков и встраивания, без кеша.
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "no-store"
</IfModule>
